menu "ST7789 display"

    config LCD_PIN_SCLK
        int "SCL / SCK GPIO"
        range 0 48
        default 12

    config LCD_PIN_MOSI
        int "SDA / MOSI GPIO"
        range 0 48
        default 11

    config LCD_PIN_CS
        int "CS GPIO (-1 for permanently grounded CS)"
        range -1 48
        default 10

    config LCD_PIN_DC
        int "A0 / AO / DC GPIO"
        range 0 48
        default 9

    config LCD_PIN_RESET
        int "RESET GPIO (-1 for software reset)"
        range -1 48
        default 8

    config LCD_PIN_BL
        int "Backlight control GPIO (-1 for external backlight power)"
        range -1 48
        default -1
        help
            Use a module BL logic input or an external transistor/MOSFET.
            A GPIO is a control signal, not a backlight power supply.
            PWM reserves LEDC low-speed timer 0 and channel 0.

    config LCD_BL_ACTIVE_LOW
        bool "Backlight control is active low"
        depends on LCD_PIN_BL >= 0
        default n

    config LCD_SPI_CLOCK_MHZ
        int "SPI clock (MHz; try 10 or 20 with jumper wires)"
        range 1 40
        default 20

    choice LCD_ROTATION
        prompt "Display rotation"
        default LCD_ROTATION_0

        config LCD_ROTATION_0
            bool "0 degrees, 240x320"
        config LCD_ROTATION_90
            bool "90 degrees, 320x240"
        config LCD_ROTATION_180
            bool "180 degrees, 240x320"
        config LCD_ROTATION_270
            bool "270 degrees, 320x240"
    endchoice

    config LCD_BGR_ORDER
        bool "BGR element order (toggle if red and blue are reversed)"
        default n

    config LCD_INVERT_COLORS
        bool "Enable panel inversion (INVON)"
        default n
        help
            Sends the ST7789 INVON command, which complements every colour.
            Leave it off unless the panel really needs it: with inversion
            wrongly enabled, red is shown as cyan (light blue), green as
            magenta (purple) and blue as yellow, and white becomes black.
            Only a module that renders a photo-negative picture while this
            option is off really needs it enabled.

endmenu

menu "Navigation buttons"

    config BUTTON_PIN_UP
        int "UP button GPIO"
        range 0 48
        default 4

    config BUTTON_PIN_DOWN
        int "DOWN button GPIO"
        range 0 48
        default 5

    config BUTTON_PIN_LEFT
        int "LEFT button GPIO"
        range 0 48
        default 6

    config BUTTON_PIN_RIGHT
        int "RIGHT button GPIO"
        range 0 48
        default 13

    config BUTTON_PIN_OK
        int "OK / confirm button GPIO"
        range 0 48
        default 14

    config BUTTON_DEBOUNCE_MS
        int "Press and release debounce (ms)"
        range 10 100
        default 30

endmenu

menu "Demo application"

    choice DEMO_APP
        prompt "Demo application"
        default DEMO_APP_LVGL

        config DEMO_APP_LVGL
            bool "LVGL user interface"
            help
                Bind LVGL to the panel through components/lvgl_port and show a
                small keypad-driven UI. LVGL adds roughly 100 KB of static and
                heap RAM; see the LVGL configuration menu for the pool size.

        config DEMO_APP_RAW
            bool "Native ST7789 diagnostics and movable square"

    endchoice

endmenu
