CONFIG_IDF_TARGET="esp32s3"

# ---- Display: ST7789V 240x320 panel, mounted landscape (rotation 90) ----
CONFIG_LCD_PIN_SCLK=12
CONFIG_LCD_PIN_MOSI=11
CONFIG_LCD_PIN_CS=10
CONFIG_LCD_PIN_DC=9
CONFIG_LCD_PIN_RESET=8
CONFIG_LCD_PIN_BL=-1
CONFIG_LCD_SPI_CLOCK_MHZ=20
CONFIG_LCD_ROTATION_90=y
# Keep INVON off: with inversion on, red turns cyan and green turns magenta.

# ---- LVGL ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_MEM_SIZE_KILOBYTES=96

# ---- Five-way keypad, active low, internal pull-ups ----
CONFIG_BUTTON_PIN_UP=4
CONFIG_BUTTON_PIN_DOWN=5
CONFIG_BUTTON_PIN_LEFT=6
CONFIG_BUTTON_PIN_RIGHT=13
CONFIG_BUTTON_PIN_OK=14
CONFIG_BUTTON_DEBOUNCE_MS=30

# ---- Shared payload/STM32 link: UART2 TX=19 RX=20 ----
CONFIG_UART_LINK_PORT=2
CONFIG_UART_LINK_TX_GPIO=19
CONFIG_UART_LINK_RX_GPIO=20
CONFIG_UART_LINK_BAUD=115200
CONFIG_UART_LINK_APPEND_CRLF=y

# ---- STM32 USART bootloader: UART2 TX=19 RX=20, BOOT0=15, NRST=16 ----
CONFIG_STM32_BOOT0_GPIO=15
CONFIG_STM32_NRST_GPIO=16
CONFIG_STM32_UART_BAUD=57600
CONFIG_STM32_BYTE_PACING_MS=1
CONFIG_STM32_DEFAULT_BASE=0x08000000
CONFIG_STM32_DEFAULT_PAGE_SIZE=2048
CONFIG_STM32_ERASE_CHUNK=4
CONFIG_STM32_MASS_ERASE_FALLBACK=y
CONFIG_STM32_VERIFY_AFTER_WRITE=y

# ---- BLE (NimBLE peripheral only, saves RAM) ----
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# ---- Flash: 2 MB, custom table with a SPIFFS "storage" partition ----
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
# GPIO19/20 are routed to the STM32 bootloader, so the USB-Serial/JTAG PHY stays off.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y


# SWD programmer for STM32F103
CONFIG_STM32_PROGRAMMER_SWD=y
CONFIG_STM32_SWD_MANUAL_RESET=n
CONFIG_STM32_SWD_WIRED_RESET=n
# CONFIG_STM32_PROGRAMMER_USART is not set
CONFIG_STM32_SWDIO_GPIO=19
CONFIG_STM32_SWCLK_GPIO=20
CONFIG_STM32_SWD_DELAY_US=1
